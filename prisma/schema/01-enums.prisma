enum BodyPersistence {
  none // Por defecto. Solo metadatos; el cuerpo nunca toca disco.
  metadata_only
  truncated // Primeros N bytes, N configurable por workspace.
  full // Requiere opt-in explicito y expires_at obligatorio.

  @@map("body_persistence")
}


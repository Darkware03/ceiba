enum UserStatus {
  active
  invited
  suspended
  deactivated

  @@map("user_status")
}

enum WorkspaceRole {
  owner // Administra workspace y miembros. Unico que transfiere propiedad y borra el workspace.
  admin // Gestiona recursos y permisos salvo operaciones reservadas al propietario.
  editor // Crea, modifica, mueve y organiza recursos autorizados.
  executor // Ejecuta solicitudes y pruebas sin alterar la estructura compartida.
  viewer // Solo lectura de recursos autorizados.

  @@map("workspace_role")
}

enum MembershipStatus {
  active
  suspended
  removed

  @@map("membership_status")
}

enum PlatformRole {
  platform_admin // Administrador de la INSTANCIA, no de un workspace. Unico principal que escribe scoped_variables con scope=global y que autoriza destinos de egreso (C-SSRF-11). No concede por si mismo ningun permiso dentro de un workspace.

  @@map("platform_role")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum AuthTokenPurpose {
  email_verification // Confirma que el buzon de user_auth_tokens.target_email pertenece al usuario. Al consumirse escribe users.email_verified_at.
  password_reset // Permite fijar una contrasena nueva sin conocer la anterior. Al consumirse revoca todas las sesiones del usuario (ADR-0009 8).
  mfa_challenge // Reto de corta vida entre la contrasena correcta y la sesion cuando mfa_enabled. NO es una sesion a medias: sessions solo recibe fila tras validar el TOTP (ADR-0009 8).

  @@map("auth_token_purpose")
}

enum LifecycleStatus {
  active
  archived

  @@map("lifecycle_status")
}

enum CollectionVisibility {
  private // Solo miembros del workspace con permiso.
  link_public // Enlace publico sin cuenta.
  link_private // Enlace + codigo de acceso hasheado.

  @@map("collection_visibility")
}

enum SharePermission {
  viewer // Solo lectura.
  viewer_export // Lectura y descarga/exportacion (sin secretos).
  executor // Ejecucion. Desactivado por defecto; nunca concede edicion.

  @@map("share_permission")
}

enum ShareState {
  active
  expired
  revoked

  @@map("share_state")
}

enum AccessAttemptResult {

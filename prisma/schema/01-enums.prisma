  @@map("param_kind")
}

enum AuthMode {
  inherit // Hereda del ancestro mas cercano: carpeta -> coleccion -> workspace.
  none // Corta la herencia explicitamente.
  explicit // Usa la auth_configuration asociada.

  @@map("auth_mode")
}


/// SharedLink -> tabla `shared_links`.
/// CHECK ck_share_no_edit: la enumeracion share_permission no contiene ningun
/// valor de edicion. Es imposible conceder escritura por enlace porque el tipo
/// no lo permite (seccion 6: nunca concedas permisos de edicion mediante un
/// enlace publico o codigo compartido).
/// CHECK ck_share_exec: allow_execution = false OR permission = 'executor'.
/// CHECK ck_share_revoked: (state = 'revoked') = (revoked_at IS NOT NULL).
///
/// REVOCACION INMEDIATA: la autorizacion de cada peticion se resuelve leyendo
/// `state`, `expires_at` y `revoked_at` de esta fila. No hay token firmado con
/// la decision dentro, asi que no existe ventana en la que un JWT ya emitido
/// siga valiendo despues de revocar. Es la razon de no usar JWT aqui.
///
/// Un enlace NO alcanza `secrets` ni `environments` por ninguna ruta de FK.
///
model SharedLink {
  id                 String          @id @default(uuid(7)) @db.Uuid
  collectionId       String          @map("collection_id") @db.Uuid
  workspaceId        String          @map("workspace_id") @db.Uuid // Denormalizado para poder revocar todos los enlaces de un workspace sin JOIN.
  publicSlug         String          @map("public_slug") // Parte visible de la URL. Aleatorio (>=128 bits), NO derivado del nombre ni del id interno. Por si solo NO revela el contenido privado.
  requiresAccessCode Boolean         @default(false) @map("requires_access_code") // true = coleccion privada con codigo (seccion 6).
  permission         SharePermission @default(viewer)
  allowExecution     Boolean         @default(false) @map("allow_execution") // Desactivado por defecto. Solo tiene efecto si permission = executor Y el workspace lo permite.
  allowExport        Boolean         @default(false) @map("allow_export")
  includeExamples    Boolean         @default(true) @map("include_examples")
  state              ShareState      @default(active)
  expiresAt          DateTime?       @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?       @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId    String?         @map("revoked_by_user_id") @db.Uuid
  maxViews           Int?            @map("max_views") // NULL = sin limite.
  viewCount          BigInt          @default(0) @map("view_count")
  lastAccessedAt     DateTime?       @map("last_accessed_at") @db.Timestamptz(6)
  createdByUserId    String          @map("created_by_user_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  // --- Relaciones -------------------------------------------------------
  collection          Collection           @relation("fk_share_collection", fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_share_collection")
  createdByUser       User                 @relation("fk_share_creator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_share_creator")
  revokedByUser       User?                @relation("fk_share_revoker", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_share_revoker")
  workspace           Workspace            @relation("fk_share_ws", fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_share_ws")
  shareAccessAttempts ShareAccessAttempt[] @relation("fk_attempt_link")
  auditLogs           AuditLog[]           @relation("fk_audit_share")
  requestHistory      RequestHistory[]     @relation("fk_history_share")
  collectionRuns      CollectionRun[]      @relation("fk_run_share")
  shareAccessCodes    ShareAccessCode[]    @relation("fk_sharecode_link")
  shareSessions       ShareSession[]       @relation("fk_sharesession_link")

  @@unique([publicSlug], map: "uq_sharedlink_slug")
  @@index([collectionId, state], map: "ix_sharedlink_collection")
  @@index([workspaceId, state], map: "ix_sharedlink_workspace")
  @@index([state, expiresAt], map: "ix_sharedlink_expiry")
  @@map("shared_links")
}

/// ShareAccessCode -> tabla `share_access_codes`.
/// REQUISITO NO NEGOCIABLE, IMPLEMENTADO AQUI.
///
/// No hay columna de codigo en claro. El codigo se entrega una sola vez, en el
/// momento de generarlo, y despues solo existe como `code_verifier_hash`.
///
/// Por que selector + verifier y no un unico hash:
/// con un unico hash de Argon2id la validacion exigiria recorrer los codigos
/// vivos y hashear contra cada uno (Argon2 no permite buscar por igualdad). Eso
/// es O(n) por intento y convierte el login compartido en un amplificador de
/// DoS. Con selector la busqueda es un indice unico y solo se hashea UNA vez.
/// El selector no es secreto y no sirve para entrar.
///
/// Como se cumple el resto de la seccion 6:
///  - Generacion criptografica: responsabilidad del backend (CSPRNG). El modelo
///    no puede imponerla; lo digo en lugar de aparentar que si.
///  - Limite de intentos: `max_attempts` + `failed_attempt_count` + `locked_until`.
///  - Rate limiting: `share_access_attempts` da la ventana deslizante por IP.
///  - Mensajes que no revelan si un codigo existe: la API devuelve la MISMA
///    respuesta para selector inexistente, hash que no casa, caducado y
///    revocado. El esquema lo facilita guardando el motivo real solo en
///    `share_access_attempts.result`, no en la respuesta.
///  - Revocacion y expiracion efectivas: `state`, `revoked_at`, `expires_at`,
///    evaluados en cada peticion.
///  - Rotar y regenerar: `rotated_from_code_id`.
///  - Nunca en logs ni en URLs: el codigo viaja en el CUERPO de un POST. En la
///    URL solo va `shared_links.public_slug`, que no es el codigo.
///  - No concede acceso al workspace: esta tabla cuelga de `shared_links`, que
///    cuelga de UNA coleccion. No hay ninguna FK desde aqui a `workspace_members`.
///
/// CHECK ck_code_attempts: failed_attempt_count >= 0 AND max_attempts > 0.
/// CHECK ck_code_uses: max_uses IS NULL OR use_count <= max_uses.
/// CHECK ck_code_hint_len: code_hint IS NULL OR length(code_hint) <= 4.
/// Indice unico parcial real: un solo codigo activo por enlace si la politica
/// del workspace lo exige:
///   CREATE UNIQUE INDEX uq_sharecode_one_active ON share_access_codes
///     (shared_link_id) WHERE state = 'active';
///
model ShareAccessCode {
  id                 String     @id @default(uuid(7)) @db.Uuid
  sharedLinkId       String     @map("shared_link_id") @db.Uuid
  codeSelector       String     @map("code_selector") // Parte NO secreta del codigo, para localizar la fila sin escanear. Aleatoria.
  codeVerifierHash   Bytes      @map("code_verifier_hash") // HASH del codigo. Argon2id (o bcrypt). EL CODIGO EN CLARO NO SE GUARDA EN NINGUNA PARTE.
  hashAlgorithm      String     @default("argon2id") @map("hash_algorithm")
  hashParams         Json       @default("{}") @map("hash_params") // Coste de memoria, iteraciones y paralelismo, para poder rehashear al subir el coste sin invalidar codigos.
  codeHint           String?    @map("code_hint") // Como maximo los 4 ultimos caracteres, solo para que el propietario distinga entre varios codigos en la interfaz. Opcional y desactivable.
  label              String?
  state              ShareState @default(active)
  maxAttempts        Int        @default(10) @map("max_attempts")
  failedAttemptCount Int        @default(0) @map("failed_attempt_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6) // Bloqueo temporal tras superar max_attempts.
  maxUses            Int?       @map("max_uses")
  useCount           BigInt     @default(0) @map("use_count")
  expiresAt          DateTime?  @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?  @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId    String?    @map("revoked_by_user_id") @db.Uuid
  rotatedFromCodeId  String?    @map("rotated_from_code_id") @db.Uuid // Cadena de rotacion: rotar genera fila nueva y revoca la anterior.
  createdByUserId    String     @map("created_by_user_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt         DateTime?  @map("last_used_at") @db.Timestamptz(6)

  // --- Relaciones -------------------------------------------------------
  createdByUser       User                 @relation("fk_sharecode_creator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_sharecode_creator")
  sharedLink          SharedLink           @relation("fk_sharecode_link", fields: [sharedLinkId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sharecode_link")
  revokedByUser       User?                @relation("fk_sharecode_revoker", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sharecode_revoker")
  rotatedFromCode     ShareAccessCode?     @relation("fk_sharecode_rotation", fields: [rotatedFromCodeId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sharecode_rotation")
  shareAccessAttempts ShareAccessAttempt[] @relation("fk_attempt_code")
  rotatedToCodes      ShareAccessCode[]    @relation("fk_sharecode_rotation")
  shareSessions       ShareSession[]       @relation("fk_sharesession_code")

  @@unique([codeSelector], map: "uq_sharecode_selector")
  @@index([sharedLinkId, state], map: "ix_sharecode_link_state")
  @@index([state, expiresAt], map: "ix_sharecode_expiry")
  @@index([rotatedFromCodeId], map: "ix_sharecode_rotation")
  @@map("share_access_codes")
}

/// ShareSession -> tabla `share_sessions`.
/// CIERRA EL HUECO 3 DEL ADR-0009. C-CODE-06 la especifica literalmente como
/// ShareSession { id, share_link_id, permission, expires_at, revoked_at } y NO
/// existia en el esquema, asi que el control no era implementable: validar un
/// codigo no tenia donde dejar el resultado.
///
/// LAS CINCO COLUMNAS DE C-CODE-06 ESTAN TODAS. `shared_link_id` lleva el
/// nombre de la tabla a la que apunta (`shared_links`), no `share_link_id`,
/// porque las otras dos tablas del bloque ya usan ese nombre exacto
/// (share_access_codes.shared_link_id, share_access_attempts.shared_link_id) y
/// una tercera grafia para la misma columna seria una trampa. El concepto es el
/// mismo.
///
/// LAS SEIS RESTANTES NO SON ADORNO:
///  - token_selector + token_verifier_hash: C-CODE-06 pide "un identificador
///    opaco de 256 bits en una cookie", y la regla no negociable del proyecto
///    es que ningun testigo se guarda en claro. Guardar el identificador de la
///    cookie tal cual convertiria un volcado de esta tabla en acceso directo a
///    todas las colecciones compartidas vivas. Mismo patron que sessions.
///  - issued_at / last_seen_at: trazabilidad y purga. OJO: aqui NO hay
///    `idle_expires_at` como en sessions, asi que la caducidad por inactividad
///    NO esta modelada; la unica caducidad dura es `expires_at`. Si se quisiera
///    inactividad, la aplicacion la calcula sobre last_seen_at o se anade la
///    columna. C-CODE-06 no la exige. last_seen_at se escribe como mucho una vez
///    cada 60 s, igual que en sessions, para no hacer un UPDATE por peticion.
///  - revoked_at / revoked_reason: la revocacion explicita que exige C-CODE-06.
///  - client_ip: atribucion de C-CODE-08.
///
/// REVOCACION EN CASCADA, QUE ES EL PUNTO DE C-CODE-06: "Revocar el enlace
/// cancela en cascada todas sus sesiones en la misma transaccion". Eso es
/// trabajo de la aplicacion (marcar revoked_at), no de la FK: ON DELETE CASCADE
/// solo actua al BORRAR la fila del enlace, y los enlaces se revocan, no se
/// borran. La FK esta en cascade por el otro motivo: si algun dia se borra de
/// verdad un enlace o un codigo, sus sesiones deben desaparecer con el, nunca
/// quedar colgando (fallo cerrado).
///   UPDATE share_sessions SET revoked_at = now(), revoked_reason = 'link_revoked'
///    WHERE shared_link_id = :enlace AND revoked_at IS NULL;
///
/// VALIDACION DE CADA PETICION (C-CODE-06, sin cache o con cache <= 5 s).
/// Siete comprobaciones, no cinco; una version anterior de esta nota se dejaba
/// dos y las anadio una revision independiente:
///  1. separar selector, buscar por uq_sharesession_selector;
///  2. comparar SHA-256(verificador) en tiempo constante;
///  3. la sesion viva: revoked_at IS NULL AND expires_at > now();
///  4. el ENLACE padre vivo: state = 'active', revoked_at IS NULL,
///     (expires_at IS NULL OR expires_at > now());
///     Nota de divergencia literal con C-CODE-06, que escribe
///     "share_link.expires_at > now()" a secas: shared_links.expires_at es
///     NULLABLE y NULL significa "sin caducidad". Se respeta el dato existente;
///     tratar NULL como caducado romperia todos los enlaces perpetuos.
///  5. el CODIGO padre vivo, si share_access_code_id no es NULL:
///     state = 'active', revoked_at IS NULL,
///     (expires_at IS NULL OR expires_at > now()).
///     Sin este paso, rotar o revocar un codigo no cerraria las sesiones que
///     abrio, que es justo para lo que se guarda share_access_code_id y lo que
///     nombran 'code_revoked' y 'code_rotated' en revoked_reason.
///  6. share_sessions.permission = shared_links.permission, Y TAMBIEN
///     shared_links.allow_execution y allow_export siguen permitiendo lo que se
///     pide: esas dos cambian el alcance real SIN tocar `permission`, asi que
///     comparar solo el permiso dejaria a una sesion exportando despues de que
///     el propietario desactivara la exportacion.
///  7. max_views: si shared_links.max_views no es NULL, view_count < max_views.
/// Cualquier fallo: la MISMA respuesta, sin decir cual de los siete fue.
///
/// ESTA TABLA NO AMPLIA LO QUE ALCANZA UN ENLACE, y conviene decir con precision
/// que significa eso, porque la formulacion facil es FALSA.
///
/// LO FALSO (y estaba escrito aqui hasta que lo verifique recorriendo el grafo):
/// "no hay ruta de FK desde aqui a secrets". SI la hay, en tres saltos:
///   share_sessions.shared_link_id   --fk_sharesession_link--> shared_links
///   shared_links.created_by_user_id --fk_share_creator-----> users
///   users.mfa_secret_id             --fk_users_mfa_secret--> secrets
/// Esa arista es el seed TOTP de quien CREO el enlace, no un recurso del
/// visitante, asi que el impacto de seguridad es nulo; pero la afirmacion era
/// falsa y comprobable. Lo mismo ocurre desde shared_links y desde collections,
/// que ya lo tenian antes de esta tabla.
///
/// LO CIERTO Y COMPROBADO, recorriendo las 148 Ref del grafo: desde
/// share_sessions son INALCANZABLES por FK saliente `environments`,
/// `environment_variables`, `scoped_variables`, `workspace_members`,
/// `auth_credentials` y `client_certificates`. Y el delta que introduce esta
/// tabla sobre lo que ya alcanzaba shared_links es UNA sola tabla:
/// share_access_codes. No abre ni una ruta nueva hacia nada sensible.
///
/// LO QUE DE VERDAD GARANTIZA C-CODE-07 NO ES LA TOPOLOGIA DE FK, es el guard
/// por recurso. Hay que decirlo porque shared_links.workspace_id esta
/// denormalizado a proposito y pone el workspace a UN salto: desde ahi, un
/// SELECT ... WHERE workspace_id = :x alcanza cualquiera de las tablas del
/// workspace. Ninguna clave foranea impide eso; lo impide la lista de permitidos
/// por verbo y recurso de C-CODE-07, que es codigo y se prueba con T-CODE-08.
///
/// CHECK ck_sharesession_expiry: expires_at > issued_at.
/// CHECK ck_sharesession_revoked: revoked_at IS NOT NULL OR revoked_reason IS NULL.
/// No hace falta ningun CHECK que impida la escritura: share_permission no
/// contiene ningun valor de edicion, igual que en shared_links.
///
/// Purga: borrado FISICO de filas con expires_at < now() - 30 dias, como
/// sessions. El rastro de acceso vive en share_access_attempts, que tiene su
/// propia retencion de 90 dias.
///
model ShareSession {
  id                String          @id @default(uuid(7)) @db.Uuid
  sharedLinkId      String          @map("shared_link_id") @db.Uuid
  shareAccessCodeId String?         @map("share_access_code_id") @db.Uuid // Codigo que abrio la sesion. NULL si el enlace era publico y no exigia codigo. Permite matar en bloque las sesiones de UN codigo al rotarlo.
  permission        SharePermission // INSTANTANEA del permiso en el momento de validar. No es redundante: C-CODE-06 exige comprobar en cada peticion "que el permiso sigue siendo el mismo", y eso es comparar esta columna con la del enlace. Si difieren, se deniega.
  tokenSelector     String          @map("token_selector") // Mitad publica del identificador opaco de la cookie. Indexable, NO secreta.
  tokenVerifierHash Bytes           @map("token_verifier_hash") // SHA-256 del verificador. Selector 128 bits + verificador 256 bits, los MISMOS tamanos que la sesion de usuario del ADR-0009 seccion 2: C-CODE-06 pide >=256 bits de identificador opaco y partir 256 en dos dejaria el secreto por debajo. El identificador en claro nunca se guarda.
  clientIp          String?         @map("client_ip") @db.Inet // IP del visitante. C-CODE-08 exige auditoria "con share_session_id e IP" para la ejecucion compartida, donde no hay cuenta detras, y la cuota de 10 ejecuciones/hora es POR SESION. share_access_attempts solo registra el intento de codigo, no lo que la sesion hace despues.
  issuedAt          DateTime        @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastSeenAt        DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(6) // Obligatorio. Se evalua SIEMPRE con la hora del servidor, nunca con una fecha del cliente (C-CODE-06).
  revokedAt         DateTime?       @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?         @map("revoked_reason") // link_revoked | link_expired | code_revoked | code_rotated | permission_changed | logout | admin_revoked.

  // --- Relaciones -------------------------------------------------------
  shareAccessCode ShareAccessCode? @relation("fk_sharesession_code", fields: [shareAccessCodeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sharesession_code")
  sharedLink      SharedLink       @relation("fk_sharesession_link", fields: [sharedLinkId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sharesession_link")

  @@unique([tokenSelector], map: "uq_sharesession_selector")
  @@index([sharedLinkId, revokedAt], map: "ix_sharesession_link")
  @@index([shareAccessCodeId], map: "ix_sharesession_code")
  @@index([expiresAt], map: "ix_sharesession_expiry")
  @@map("share_sessions")
}

/// ShareAccessAttempt -> tabla `share_access_attempts`.
/// Tabla de alta rotacion. Decisiones:
///  - `bigserial` y no uuid: es append-only de alto volumen y nunca se referencia
///    desde fuera; un entero secuencial da mejor densidad de indice.
///  - PARTICIONADA POR RANGO sobre attempted_at (mensual) en la migracion real.
///    DBML no expresa particiones. La purga es DROP PARTITION, no DELETE masivo.
///  - Retencion: 90 dias por defecto.
///  - NO guarda el codigo intentado, ni completo ni parcial. Registrar el intento
///    fallido con el valor probado convertiria el log de seguridad en un
///    diccionario de codigos.
/// Sirve a dos requisitos: limitar intentos y registrar accesos y eventos
/// relevantes (seccion 6).
///
model ShareAccessAttempt {
  id                  BigInt              @id @default(autoincrement())
  sharedLinkId        String              @map("shared_link_id") @db.Uuid
  shareAccessCodeId   String?             @map("share_access_code_id") @db.Uuid // NULL si el selector no existia. Registrarlo NULL evita confirmar la existencia del codigo.
  result              AccessAttemptResult
  clientIp            String?             @map("client_ip") @db.Inet
  clientIpPrefix      String?             @map("client_ip_prefix") @db.Inet // IP truncada (/24 IPv4, /64 IPv6) para rate limiting agregado con menos dato personal.
  userAgentHash       Bytes?              @map("user_agent_hash") // Hash, no el UA completo: suficiente para correlacionar, menos superficie de PII.
  authenticatedUserId String?             @map("authenticated_user_id") @db.Uuid // Si quien intenta tiene sesion iniciada.
  attemptedAt         DateTime            @default(now()) @map("attempted_at") @db.Timestamptz(6)

  // --- Relaciones -------------------------------------------------------
  shareAccessCode   ShareAccessCode? @relation("fk_attempt_code", fields: [shareAccessCodeId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_attempt_code")
  sharedLink        SharedLink       @relation("fk_attempt_link", fields: [sharedLinkId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attempt_link")
  authenticatedUser User?            @relation("fk_attempt_user", fields: [authenticatedUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_attempt_user")

  @@index([sharedLinkId, attemptedAt], map: "ix_attempt_link_time")
  @@index([clientIpPrefix, attemptedAt], map: "ix_attempt_ip_time")
  @@index([result, attemptedAt], map: "ix_attempt_result_time")
  @@index([attemptedAt], map: "ix_attempt_time")
  @@map("share_access_attempts")
}

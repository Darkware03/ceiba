/// User -> tabla `users`.
/// CHECK ck_users_locked: locked_until IS NULL OR locked_until > created_at.
/// CHECK ck_users_pwd_or_sso: password_hash IS NOT NULL OR status <> 'active'
///   ... relajado si hay SSO; ver MODELO-DATOS.md.
/// El indice unico de email es PARCIAL en la migracion real:
///   CREATE UNIQUE INDEX uq_users_email ON users (email) WHERE deleted_at IS NULL;
/// DBML no expresa indices parciales.
///
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String // citext -> unicidad case-insensitive sin indice funcional.
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash      String?    @map("password_hash") // Argon2id. NULL si la cuenta es solo SSO. Nunca se devuelve por la API.
  passwordUpdatedAt DateTime?  @map("password_updated_at") @db.Timestamptz(6)
  displayName       String     @map("display_name")
  avatarFileId      String?    @map("avatar_file_id") @db.Uuid
  locale            String     @default("es")
  timezone          String     @default("UTC")
  status            UserStatus @default(invited)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaSecretId       String?    @map("mfa_secret_id") @db.Uuid // FK a secrets. El seed TOTP jamas se guarda en claro.
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6) // Borrado logico. El correo se libera al purgar, no al borrar.

  // --- Relaciones -------------------------------------------------------
  avatarFile                 File?                @relation("fk_users_avatar", fields: [avatarFileId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_users_avatar")
  mfaSecret                  Secret?              @relation("fk_users_mfa_secret", fields: [mfaSecretId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_users_mfa_secret")
  shareAccessAttempts        ShareAccessAttempt[] @relation("fk_attempt_user")
  auditLogs                  AuditLog[]           @relation("fk_audit_actor")
  authConfigurations         AuthConfiguration[]  @relation("fk_authcfg_creator")
  authCredentials            AuthCredential[]     @relation("fk_authcred_owner")
  userAuthTokens             UserAuthToken[]      @relation("fk_authtoken_user")
  clientCertificates         ClientCertificate[]  @relation("fk_cert_creator")
  collectionsCreatedBy       Collection[]         @relation("fk_collection_creator")
  collectionsDeletedBy       Collection[]         @relation("fk_collection_deleter")
  commentsAuthor             Comment[]            @relation("fk_comment_author")
  commentsResolvedBy         Comment[]            @relation("fk_comment_resolver")
  cookieJarEntries           CookieJarEntry[]     @relation("fk_cookie_owner")
  environmentsCreatedBy      Environment[]        @relation("fk_env_creator")
  environmentsDeletedBy      Environment[]        @relation("fk_env_deleter")
  environmentsOwner          Environment[]        @relation("fk_env_owner")
  files                      File[]               @relation("fk_file_owner")
  collectionFoldersCreatedBy CollectionFolder[]   @relation("fk_folder_creator")
  collectionFoldersDeletedBy CollectionFolder[]   @relation("fk_folder_deleter")
  requestHistory             RequestHistory[]     @relation("fk_history_user")
  invitationsAcceptedBy      Invitation[]         @relation("fk_inv_accepted_by")
  invitationsInvitedBy       Invitation[]         @relation("fk_inv_invited_by")
  workspaceMembersInvitedBy  WorkspaceMember[]    @relation("fk_member_invited_by")
  workspaceMembersUser       WorkspaceMember[]    @relation("fk_member_user")
  notificationsActor         Notification[]       @relation("fk_notif_actor")
  notificationsRecipient     Notification[]       @relation("fk_notif_recipient")
  platformAdminsGrantedBy    PlatformAdmin[]      @relation("fk_platform_admin_granter")
  platformAdminsRevokedBy    PlatformAdmin[]      @relation("fk_platform_admin_revoker")
  platformAdminsUser         PlatformAdmin[]      @relation("fk_platform_admin_user")
  projectsCreatedBy          Project[]            @relation("fk_project_creator")
  projectsDeletedBy          Project[]            @relation("fk_project_deleter")
  requestTags                RequestTag[]         @relation("fk_reqtag_user")
  apiRequestsCreatedBy       ApiRequest[]         @relation("fk_request_creator")
  apiRequestsDeletedBy       ApiRequest[]         @relation("fk_request_deleter")
  retentionPolicies          RetentionPolicy[]    @relation("fk_retention_user")
  collectionRuns             CollectionRun[]      @relation("fk_run_user")
  scopedVariables            ScopedVariable[]     @relation("fk_scopedvar_creator")
  secrets                    Secret[]             @relation("fk_secret_creator")
  sessions                   Session[]            @relation("fk_sessions_user")
  sharedLinksCreatedBy       SharedLink[]         @relation("fk_share_creator")
  sharedLinksRevokedBy       SharedLink[]         @relation("fk_share_revoker")
  shareAccessCodesCreatedBy  ShareAccessCode[]    @relation("fk_sharecode_creator")
  shareAccessCodesRevokedBy  ShareAccessCode[]    @relation("fk_sharecode_revoker")
  testDefinitions            TestDefinition[]     @relation("fk_test_creator")
  variableLocalValues        VariableLocalValue[] @relation("fk_varlocal_user")
  collectionVersions         CollectionVersion[]  @relation("fk_version_creator")
  workspacesDeletedBy        Workspace[]          @relation("fk_ws_deleted_by")
  workspacesOwner            Workspace[]          @relation("fk_ws_owner")

  @@unique([email], map: "uq_users_email")
  @@index([status, createdAt], map: "ix_users_status_created")
  @@index([deletedAt], map: "ix_users_deleted_at")
  @@map("users")
}

/// Session -> tabla `sessions`.
/// Patron selector/verifier: la busqueda es O(1) por selector y la comparacion
/// del verifier es en tiempo constante. Evita escanear la tabla hasheando fila a
/// fila y evita el timing leak de comparar hashes con ==.
/// Indice parcial real: ... ON sessions (user_id) WHERE revoked_at IS NULL.
/// Purga: borrado FISICO de filas con absolute_expires_at < now() - 30 dias.
///
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenSelector     String    @map("token_selector") // Mitad publica del refresh token. Indexable, NO secreta.
  tokenVerifierHash Bytes     @map("token_verifier_hash") // SHA-256 de la mitad secreta. El token en claro nunca se guarda.
  parentSessionId   String?   @map("parent_session_id") @db.Uuid // Rotacion de refresh token: detecta reutilizacion de token robado.
  userAgent         String?   @map("user_agent")
  clientIp          String?   @map("client_ip") @db.Inet
  deviceLabel       String?   @map("device_label")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6) // Caducidad dura; no se extiende con el uso.
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6) // Caducidad por inactividad; se desplaza al refrescar.
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?   @map("revoked_reason")

  // --- Relaciones -------------------------------------------------------
  parentSession Session?   @relation("fk_sessions_parent", fields: [parentSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sessions_parent")
  user          User       @relation("fk_sessions_user", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sessions_user")
  auditLogs     AuditLog[] @relation("fk_audit_session")
  childSessions Session[]  @relation("fk_sessions_parent")

  @@unique([tokenSelector], map: "uq_sessions_selector")
  @@index([userId, lastSeenAt], map: "ix_sessions_user_lastseen")
  @@index([absoluteExpiresAt], map: "ix_sessions_abs_expiry")
  @@index([parentSessionId], map: "ix_sessions_parent")
  @@map("sessions")
}

/// PlatformAdmin -> tabla `platform_admins`.
/// CIERRA EL HUECO 1 DEL ADR-0009. Dos sitios exigian este rol y ninguno lo
/// tenia: `variable_scope.global` ("Solo administradores de plataforma") y
/// C-SSRF-11 ("rol de administrador de la instancia, no propietario de
/// workspace"). Mientras no existio, ambas capacidades eran INALCANZABLES.
///
/// POR QUE UNA TABLA Y NO UNA COLUMNA EN `users`:
///  1. Procedencia. En este esquema ningun privilegio existe sin saber quien lo
///     dio y cuando: workspace_members.invited_by_user_id, shared_links.
///     revoked_by_user_id, share_access_codes.revoked_by_user_id. Un booleano en
///     `users` seria el unico privilegio del producto sin rastro de concesion, y
///     ademas el mas peligroso de todos.
///  2. Simetria con la tabla de autorizacion canonica. El ADR-0009 7.4 resuelve
///     TODO permiso leyendo una fila de pertenencia con estado
///     (workspace_members). Esta tabla es esa misma forma a nivel de instancia,
///     asi que el guard declarativo es el mismo objeto con otro puerto.
///  3. Revocacion y caducidad. `revoked_at` y `expires_at` son columnas; en un
///     booleano son historia perdida.
///  4. Riesgo de cambio. Anadir una tabla no toca `users`, que es la tabla mas
///     caliente del esquema y contra la que hay dos agentes escribiendo codigo
///     ahora mismo. C-23 prohibe reestructurar: crear es mas seguro que alterar.
///
/// COMO SE EVALUA (no viaja en la cookie, igual que el rol de workspace):
///   SELECT 1 FROM platform_admins
///    WHERE user_id = :usuario AND role = 'platform_admin'
///      AND revoked_at IS NULL AND (expires_at IS NULL OR expires_at > now());
/// Se revalida en cada operacion, como exige la seccion 5 del prompt maestro.
///
/// Indice unico PARCIAL real (DBML no expresa el predicado):
///   CREATE UNIQUE INDEX uq_platform_admin_user_role ON platform_admins
///     (user_id, role) WHERE revoked_at IS NULL;
/// Sin el predicado, revocar un administrador impediria volver a nombrarlo.
/// OJO, y esto hay que leerlo antes de implementar la renovacion: una concesion
/// CADUCADA (expires_at < now()) pero no revocada SIGUE ocupando el unico. Para
/// volver a conceder tras una caducidad hay que escribir revoked_at primero. Es
/// deliberado —dejar caducar no es revocar, y dos filas vivas con el mismo
/// (user_id, role) harian ambigua la consulta de autorizacion— pero tiene un
/// coste: en la auditoria, esa revocacion es administrativa, no una decision
/// humana de retirar el privilegio. Conviene distinguirlas en revoked_reason
/// ('expired' frente a 'admin_revoked').
///
/// CHECK ck_platform_admin_expiry: expires_at IS NULL OR expires_at > granted_at.
/// CHECK ck_platform_admin_revoked: revoked_at IS NOT NULL
///    OR (revoked_by_user_id IS NULL AND revoked_reason IS NULL).
/// CHECK ck_platform_admin_not_self: granted_by_user_id IS NULL
///    OR granted_by_user_id <> user_id.   -- separacion de funciones
/// El tercero es PROPUESTA MIA, no requisito citado: impide que un
/// administrador se renueve a si mismo el privilegio. La concesion de arranque
/// lleva granted_by_user_id NULL y por eso no choca con el.
///
/// LO QUE ESTA TABLA NO HACE: no concede ningun permiso dentro de un workspace.
/// Un administrador de plataforma que no sea miembro de un workspace sigue sin
/// leer sus colecciones. Ninguna celda de la matriz del ADR-0009 7.5 cambia de
/// valor.
///
/// PERO SI CAMBIA EL ESTATUS DE LA MATRIZ, y seria deshonesto no decirlo. La
/// 7.5 se declara "lista de permitidos: lo que no esta, se deniega", y su ultima
/// fila ("Escribir variables de ambito global: X para los cinco roles") se
/// explicaba con "ese rol no existe en el esquema; hasta que exista, la
/// escritura global no es alcanzable". Ya existe. Hay por tanto un principal
/// con una capacidad que la matriz no enumera, asi que la matriz dejo de ser
/// cerrada: le falta una columna. Anadirla es del software-architect, no mia.
/// Va como HUECO.
///
/// LO QUE FALTA PARA QUE ESTO SEA ALCANZABLE DE VERDAD, dicho sin vender la
/// tabla de mas: el ADR-0009 7.3 declara UN solo puerto,
/// WorkspaceAuthorizationPort, y el guard resuelve contra workspace_members.
/// Un administrador de plataforma no tiene workspace, asi que cae fuera de esa
/// maquinaria: hacen falta un PlatformAuthorizationPort y un decorador
/// @RequirePlatformRole que nadie ha decidido todavia. Esta tabla pone el dato;
/// NO pone el punto de evaluacion.
///
/// Y FALTA LA CERRADURA DE C-SSRF-11: el control nombra la tabla
/// `EgressAllowRule` como el sitio donde viven las excepciones de egreso, y esa
/// tabla NO EXISTE en este esquema. Con platform_admins se ha creado la llave;
/// sin EgressAllowRule sigue sin haber puerta. Va como HUECO, y es del mismo
/// ambito B.
///
model PlatformAdmin {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  role            PlatformRole @default(platform_admin)
  grantedByUserId String?      @map("granted_by_user_id") @db.Uuid // NULL en la concesion de arranque (semilla de instalacion, sin concedente) Y TAMBIEN si el concedente se borra despues: la FK es ON DELETE SET NULL. Los dos casos son indistinguibles en esta fila; la procedencia duradera vive en audit_logs, que sobrevive al borrado del actor por target_label.
  grantedReason   String?      @map("granted_reason") // Por que se concedio. Exigido por el procedimiento, no por el tipo: el CHECK no puede medir si el texto es util.
  grantedAt       DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz(6) // NULL = sin caducidad. Permite elevacion temporal con devolucion automatica del privilegio.
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?      @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?      @map("revoked_reason")

  // --- Relaciones -------------------------------------------------------
  grantedByUser User? @relation("fk_platform_admin_granter", fields: [grantedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_platform_admin_granter")
  revokedByUser User? @relation("fk_platform_admin_revoker", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_platform_admin_revoker")
  user          User  @relation("fk_platform_admin_user", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_platform_admin_user")

  @@unique([userId, role], map: "uq_platform_admin_user_role")
  @@index([role, revokedAt], map: "ix_platform_admin_role_revoked")
  @@index([expiresAt], map: "ix_platform_admin_expiry")
  @@map("platform_admins")
}

/// UserAuthToken -> tabla `user_auth_tokens`.
/// CIERRA LOS HUECOS 2 Y 4 DEL ADR-0009: restablecimiento de contrasena,
/// verificacion de correo y reto de segundo factor. Antes de esta tabla `users`
/// solo tenia `email_verified_at` y NINGUN testigo donde vivir, de modo que los
/// tres flujos eran inimplementables.
///
/// EL TESTIGO EN CLARO NO SE GUARDA. Igual que sessions, invitations y
/// share_access_codes: selector (publico, localiza la fila por indice unico) +
/// verificador hasheado (comparacion en tiempo constante). No existe en toda la
/// tabla ninguna columna que pueda contener el valor entregado al usuario.
///
/// POR QUE UNA TABLA Y NO TRES: los tres propositos tienen el MISMO ciclo de
/// vida (emitir, entregar fuera de banda, consumir una vez, caducar) y el mismo
/// modo de fallo. El propio ADR-0009 dice del reto de 2FA que es "el mismo
/// patron que el restablecimiento de contrasena". Tres tablas serian tres
/// purgas, tres indices y tres sitios donde equivocarse.
///
/// POR QUE ESO NO ABRE UN PASO ENTRE PROPOSITOS, que es el riesgo real de
/// unificar. Dos barreras, y la primera es ESTRUCTURAL:
///
///  1. `uq_authtoken_selector` es unico sobre (purpose, token_selector), NO
///     sobre token_selector a secas. La busqueda es
///       WHERE purpose = :elQueEsperaELENDPOINT AND token_selector = :selector
///     asi que un testigo de restablecimiento presentado en el endpoint de 2FA
///     sencillamente NO SE ENCUENTRA. No es una convencion de codigo: el indice
///     impone que el proposito entre en la clave de busqueda.
///  2. El verificador se hashea con separacion de dominio,
///     SHA-256(purpose || ":" || verificador), usando el proposito QUE ESPERA EL
///     ENDPOINT, nunca el que venga en la fila.
///
/// CORRECCION DE UNA VERSION ANTERIOR DE ESTA NOTA, que decia que la defensa era
/// "criptografica, no una convencion" cuando el unico era global. ERA FALSO: con
/// un unico global el selector localiza la fila sin saber el proposito, la fila
/// trae `purpose` dentro, y cualquier implementacion natural hashea con
/// `fila.purpose` -> la separacion de dominio desaparece y el hash siempre casa.
/// Lo detecto una revision independiente y la correccion es la de arriba: meter
/// el proposito en la CLAVE DE BUSQUEDA, que si es estructural. La barrera 2,
/// por si sola, sigue siendo una convencion de codigo; se mantiene porque suma.
///
/// RADIO DE IMPACTO, que es el coste honesto de unificar: un fallo en el camino
/// de consumo (olvidar `consumed_at IS NULL`, por ejemplo) rompe los tres flujos
/// a la vez en lugar de uno. Con tres tablas quedaria contenido. Se asume a
/// cambio de una sola purga, un solo juego de indices y un solo sitio donde
/// equivocarse.
///
/// POR QUE SHA-256 Y NO Argon2id: el verificador son >=256 bits de CSPRNG, no
/// hay diccionario que atacar. Es el mismo criterio que ya aplica sessions, y el
/// contrario que share_access_codes, donde el codigo SI es de baja entropia y va
/// con Argon2id. Los dos perfiles del producto son deliberados.
///
/// Indice unico PARCIAL real (DBML no expresa el predicado):
///   CREATE UNIQUE INDEX uq_authtoken_one_live ON user_auth_tokens
///     (user_id, purpose)
///     WHERE purpose IN ('email_verification', 'password_reset')
///       AND consumed_at IS NULL AND revoked_at IS NULL;
/// Un solo testigo vivo por usuario y proposito para los dos de correo: pedir
/// otro revoca el anterior, y asi no se acumulan testigos validos en el buzon.
/// mfa_challenge queda FUERA del predicado a proposito: dos inicios de sesion
/// simultanos desde dos dispositivos son legitimos y el unico los romperia.
///
/// CHECK ck_authtoken_expiry: expires_at > issued_at.
/// CHECK ck_authtoken_attempts: attempt_count >= 0 AND max_attempts > 0.
/// CHECK ck_authtoken_target:
///   (purpose = 'email_verification') = (target_email IS NOT NULL).
/// CHECK ck_authtoken_revoked: revoked_at IS NOT NULL OR revoked_reason IS NULL.
/// CHECK ck_authtoken_terminal: consumed_at IS NULL OR revoked_at IS NULL.
///
/// AVISO SOBRE ck_authtoken_terminal, porque es facil tropezar: un barrido del
/// tipo UPDATE user_auth_tokens SET revoked_at = now() WHERE user_id = :u
/// (el que manda el ADR-0009 seccion 8 al cambiar la contrasena) REVIENTA con
/// 23514 si alcanza una fila ya consumida. Hay que filtrar
/// `AND consumed_at IS NULL`. El CHECK es correcto; lo que no puede faltar es
/// esta linea en quien lo use.
///
/// AVISO SOBRE uq_authtoken_one_live: dos peticiones concurrentes de
/// restablecimiento producen un 23505 en la segunda. C-CODE-04 exige que la
/// respuesta sea INDISTINGUIBLE, asi que ese error NO puede llegar al cliente:
/// la emision va en una transaccion que revoca lo vivo y despues inserta, y el
/// 23505 se traduce a la misma respuesta generica que todo lo demas.
///
/// LO QUE ESTA TABLA NO RESUELVE, dicho aqui y no escondido: el ANTIRREPLAY del
/// codigo TOTP. `consumed_at` impide reutilizar EL RETO, no el codigo de 6
/// digitos dentro de su ventana de 30 s en un reto nuevo. Quien observe un TOTP
/// y tenga la contrasena puede abrir otro reto y usarlo. Hace falta guardar el
/// ultimo paso temporal consumido, y su sitio natural es `users` o `secrets`,
/// no esta tabla: es estado del FACTOR, no del reto. Va como HUECO; seria
/// ALTER TABLE users ADD COLUMN mfa_last_step bigint, aditivo, pero toca una
/// tabla preexistente y no es uno de los tres huecos encargados.
///
/// Purga: borrado FISICO de filas con expires_at < now() - 7 dias. No es
/// evidencia historica: lo que hay que auditar (quien pidio que y cuando) va a
/// audit_logs, que no caduca con el testigo.
///
model UserAuthToken {
  id                String           @id @default(uuid(7)) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  purpose           AuthTokenPurpose
  tokenSelector     String           @map("token_selector") // Mitad publica del testigo (128 bits de CSPRNG). Indexable, NO secreta. Mismo patron que sessions e invitations. Unico POR PROPOSITO, no global: ver uq_authtoken_selector.
  tokenVerifierHash Bytes            @map("token_verifier_hash") // SHA-256(purpose || ":" || verificador), verificador de 256 bits. El testigo en claro NO se guarda jamas.
  targetEmail       String?          @map("target_email") // Obligatorio solo en email_verification: el testigo confirma UNA direccion concreta, no "el correo que users.email tenga al abrirlo".
  issuedAt          DateTime         @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(6) // Corta vida. Orientacion: 24 h verificacion, 30 min restablecimiento, 5 min reto 2FA. El valor lo fija la aplicacion; el esquema solo exige que exista.
  consumedAt        DateTime?        @map("consumed_at") @db.Timestamptz(6) // Un solo uso. Una vez puesto, el testigo no vuelve a validar.
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?          @map("revoked_reason") // superseded | password_changed | email_changed | user_deactivated | admin_revoked | max_attempts.
  attemptCount      Int              @default(0) @map("attempt_count") // Intentos fallidos contra ESTE testigo. Solo lo usa mfa_challenge: el TOTP son 6 digitos y sin contador es forzable.
  maxAttempts       Int              @default(5) @map("max_attempts")
  lockedUntil       DateTime?        @map("locked_until") @db.Timestamptz(6)
  clientIp          String?          @map("client_ip") @db.Inet // IP que pidio el testigo. Permite limitar por IP el envio de restablecimientos (seccion 16) y correlacionar con sessions.client_ip.
  userAgent         String?          @map("user_agent") // Huella del cliente que PIDIO el testigo. El ADR-0009 seccion 4 define la huella como client_ip MAS user_agent, no solo la IP: con IP sola, un reto de 2FA interceptado se canjea desde otro navegador en la misma red y nada lo detecta. Tambien alimenta sessions.user_agent y device_label al crear la sesion tras validar el TOTP (seccion 9).

  // --- Relaciones -------------------------------------------------------
  user User @relation("fk_authtoken_user", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_authtoken_user")

  @@unique([purpose, tokenSelector], map: "uq_authtoken_selector")
  @@index([userId, purpose, expiresAt], map: "ix_authtoken_user_purpose")
  @@index([expiresAt], map: "ix_authtoken_expiry")
  @@map("user_auth_tokens")
}

/// Workspace -> tabla `workspaces`.
/// CHECK ck_ws_retention: response_retention_days BETWEEN 0 AND 365.
/// CHECK ck_ws_maxbytes: response_max_persist_bytes BETWEEN 0 AND 10485760.
/// Indice unico real es parcial: WHERE deleted_at IS NULL (permite reutilizar
/// un slug despues de borrar un workspace).
///
model Workspace {
  id                       String          @id @default(uuid(7)) @db.Uuid
  slug                     String // Identificador estable en URL, independiente del nombre.
  name                     String
  description              String?
  iconFileId               String?         @map("icon_file_id") @db.Uuid
  iconEmoji                String?         @map("icon_emoji")
  ownerUserId              String          @map("owner_user_id") @db.Uuid // Denormalizado para consultas rapidas; la verdad esta en workspace_members.
  settings                 Json            @default("{}")
  responseBodyPersistence  BodyPersistence @default(none) @map("response_body_persistence") // Politica por defecto del workspace para cuerpos de respuesta.
  responseRetentionDays    Int             @default(7) @map("response_retention_days")
  responseMaxPersistBytes  BigInt          @default(262144) @map("response_max_persist_bytes")
  historyRetentionDays     Int             @default(90) @map("history_retention_days")
  allowPublicSharing       Boolean         @default(true) @map("allow_public_sharing")
  allowSharedLinkExecution Boolean         @default(false) @map("allow_shared_link_execution") // Ejecucion publica desactivada por defecto (seccion 6).
  status                   LifecycleStatus @default(active)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId          String?         @map("deleted_by_user_id") @db.Uuid

  // --- Relaciones -------------------------------------------------------
  deletedByUser      User?               @relation("fk_ws_deleted_by", fields: [deletedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_ws_deleted_by")
  iconFile           File?               @relation("fk_ws_icon", fields: [iconFileId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_ws_icon")
  ownerUser          User                @relation("fk_ws_owner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ws_owner")
  responseArtifacts  ResponseArtifact[]  @relation("fk_artifact_ws")
  auditLogs          AuditLog[]          @relation("fk_audit_ws")
  authConfigurations AuthConfiguration[] @relation("fk_authcfg_ws")
  clientCertificates ClientCertificate[] @relation("fk_cert_ws")
  collections        Collection[]        @relation("fk_collection_ws")
  comments           Comment[]           @relation("fk_comment_ws")
  cookieJarEntries   CookieJarEntry[]    @relation("fk_cookie_ws")
  environments       Environment[]       @relation("fk_env_ws")
  files              File[]              @relation("fk_file_ws")
  requestHistory     RequestHistory[]    @relation("fk_history_ws")
  invitations        Invitation[]        @relation("fk_inv_ws")
  workspaceMembers   WorkspaceMember[]   @relation("fk_member_ws")
  notifications      Notification[]      @relation("fk_notif_ws")
  projects           Project[]           @relation("fk_project_ws")
  retentionPolicies  RetentionPolicy?    @relation("fk_retention_ws")
  collectionRuns     CollectionRun[]     @relation("fk_run_ws")
  scopedVariables    ScopedVariable[]    @relation("fk_scopedvar_ws")
  secrets            Secret[]            @relation("fk_secret_ws")
  sharedLinks        SharedLink[]        @relation("fk_share_ws")
  tags               Tag[]               @relation("fk_tag_ws")
  testDefinitions    TestDefinition[]    @relation("fk_test_ws")

  @@unique([slug], map: "uq_workspaces_slug")
  @@index([ownerUserId], map: "ix_workspaces_owner")
  @@index([status, deletedAt], map: "ix_workspaces_status")
  @@map("workspaces")
}

/// WorkspaceMember -> tabla `workspace_members`.
/// Tabla de autorizacion canonica: TODA comprobacion de permiso del backend
/// resuelve contra esta fila, no contra el frontend (seccion 5).
/// CHECK ck_member_removed: (status = 'removed') = (removed_at IS NOT NULL).
/// Invariante de aplicacion + trigger: cada workspace no borrado tiene al menos
/// un miembro activo con role='owner'. No es expresable como CHECK de fila.
///
model WorkspaceMember {
  id              String           @id @default(uuid(7)) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  role            WorkspaceRole    @default(viewer)
  status          MembershipStatus @default(active)
  invitedByUserId String?          @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  removedAt       DateTime?        @map("removed_at") @db.Timestamptz(6)
  lastActiveAt    DateTime?        @map("last_active_at") @db.Timestamptz(6)

  // --- Relaciones -------------------------------------------------------
  invitedByUser User?     @relation("fk_member_invited_by", fields: [invitedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_member_invited_by")
  user          User      @relation("fk_member_user", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_user")
  workspace     Workspace @relation("fk_member_ws", fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_ws")

  @@unique([workspaceId, userId], map: "uq_member_ws_user")
  @@index([userId, status], map: "ix_member_user_status")
  @@index([workspaceId, role], map: "ix_member_ws_role")
  @@map("workspace_members")
}

/// Invitation -> tabla `invitations`.
/// Indice unico parcial real (no expresable en DBML):
///   CREATE UNIQUE INDEX uq_invitation_pending ON invitations (workspace_id, email)
///     WHERE status = 'pending';
/// Impide dos invitaciones vivas al mismo correo en el mismo workspace, pero
/// permite reinvitar tras revocar o caducar.
/// CHECK ck_inv_accept: (status = 'accepted') = (accepted_at IS NOT NULL).
///
model Invitation {
  id                String           @id @default(uuid(7)) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  email             String
  role              WorkspaceRole    @default(viewer)
  tokenSelector     String           @map("token_selector") // Parte publica del enlace de invitacion.
  tokenVerifierHash Bytes            @map("token_verifier_hash") // Hash del token. Nunca el token en claro.
  status            InvitationStatus @default(pending)
  message           String?
  invitedByUserId   String?          @map("invited_by_user_id") @db.Uuid
  acceptedByUserId  String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz(6)
  resendCount       Int              @default(0) @map("resend_count")
  lastSentAt        DateTime?        @map("last_sent_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // --- Relaciones -------------------------------------------------------
  acceptedByUser User?          @relation("fk_inv_accepted_by", fields: [acceptedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_inv_accepted_by")
  invitedByUser  User?          @relation("fk_inv_invited_by", fields: [invitedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_inv_invited_by")
  workspace      Workspace      @relation("fk_inv_ws", fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inv_ws")
  notifications  Notification[] @relation("fk_notif_invitation")

  @@unique([tokenSelector], map: "uq_invitations_selector")
  @@index([workspaceId, email], map: "ix_invitations_ws_email")
  @@index([status, expiresAt], map: "ix_invitations_status_expiry")
  @@map("invitations")
}

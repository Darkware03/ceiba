{
  "name": "ceiba-api-studio",
  "version": "0.1.0",
  "private": true,
  "description": "CEIBA API Studio — plataforma de desarrollo, prueba, documentación y automatización de APIs.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "brand:build": "pnpm --filter @ceiba/brand run build:brand",
    "brand:check": "pnpm --filter @ceiba/brand run check:spin",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build"
  }
}

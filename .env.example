# CEIBA API Studio — plantilla de entorno.
# Copia a `.env` y rellena. NUNCA se versionan secretos reales.
# Genera los valores marcados <generar> con:  openssl rand -base64 48

# ---------- general ----------
NODE_ENV=development
CEIBA_PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info

# ---------- base de datos ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ceiba
POSTGRES_USER=ceiba
POSTGRES_PASSWORD=<generar>
DATABASE_URL=postgresql://ceiba:<generar>@postgres:5432/ceiba?schema=public

# ---------- redis (cache, colas, coordinacion de websockets) ----------
REDIS_URL=redis://redis:6379

# ---------- sesiones y tokens ----------
# Clave de firma de los tokens de sesion.
CEIBA_JWT_SECRET=<generar>
CEIBA_ACCESS_TOKEN_TTL=15m
CEIBA_REFRESH_TOKEN_TTL=30d

# ---------- cifrado de secretos en reposo ----------
# Clave maestra para el cifrado autenticado (AES-256-GCM) de tokens, claves de
# API, contrasenas y certificados que guardan los usuarios.
# En produccion debe venir de un KMS (GCP Secret Manager / Cloud KMS), no del .env.
CEIBA_SECRETS_MASTER_KEY=<generar>
CEIBA_SECRETS_KEY_PROVIDER=env   # env | gcp-kms

# ---------- motor de ejecucion HTTP ----------
CEIBA_ENGINE_URL=http://engine:3001
# Testigo compartido API -> motor. El motor RECHAZA toda peticion sin el: es lo
# unico que impide que cualquier cosa dentro de la red de contenedores use el
# motor como proxy de salida. Obligatorio tambien en desarrollo.
CEIBA_ENGINE_TOKEN=<generar>
# Proteccion SSRF. Mantener activada; las excepciones se autorizan por destino
# concreto desde la administracion, nunca desactivando el control global.
CEIBA_SSRF_PROTECTION=on
CEIBA_ENGINE_MAX_RESPONSE_BYTES=26214400
CEIBA_ENGINE_TIMEOUT_MS=30000
CEIBA_ENGINE_MAX_REDIRECTS=5

# ---------- limites de carga ----------
CEIBA_MAX_UPLOAD_BYTES=26214400
CEIBA_MAX_IMPORT_BYTES=15728640

# ---------- compartir colecciones ----------
CEIBA_SHARE_CODE_PEPPER=<generar>
CEIBA_SHARE_CODE_MAX_ATTEMPTS=10
CEIBA_SHARE_CODE_LOCKOUT_SECONDS=900

# ---------- asistente de IA (opcional; la plataforma funciona sin el) ----------
CEIBA_AI_ENABLED=false
CEIBA_AI_PROVIDER=vertex          # vertex | anthropic | openai | none
CEIBA_AI_MODEL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Ruta al fichero de credenciales montado; no pegar la clave aqui.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- correo (invitaciones) ----------
CEIBA_SMTP_URL=
CEIBA_MAIL_FROM=ceiba@example.com

*.tsbuildinfo

# entorno: nunca se versionan secretos reales
.env
.env.*
!.env.example

# material criptografico: NUNCA se versiona.
# Detectado por devops-release al escribir generate-dev-certs.sh y confirmado
# por el orquestador con `git check-ignore`: antes de esto, un `git add` de
# infra/tls/dev.key lo habria metido en el historico sin aviso.
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
infra/tls/
/tls/
certs/

# artefactos locales
*.log
.DS_Store
/tmp/
playwright-report/
test-results/

# datos de desarrollo
docker-data/

# artefactos de compilacion de pruebas
dist-test/

# dependencias de las herramientas de esquema
prisma/tools/node_modules/

# pnpm deja este lockfile vacio en la raiz al invocarse via corepack.
# El monorepo no instala en la raiz: cada app tiene el suyo.
/pnpm-lock.yaml

# artefactos de ejecucion local (pid, logs, certificado de desarrollo)
/.run/
/prisma/generated/
/prisma/node_modules/

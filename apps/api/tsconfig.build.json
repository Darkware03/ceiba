{
  // Build de producción: sólo `src/`. Salida en `dist/`, arranque con
  // `node dist/main.js`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "dist-test", "node_modules", "test"]
}

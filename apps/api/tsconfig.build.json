{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "noEmit": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts", "../../prisma/generated/client/**/*.ts"],
  "exclude": [
    "dist",
    "dist-test",
    "node_modules",
    "test",
    "src/modules/studio/studio.service.ts",
    "src/modules/studio/studio-collaboration.service.ts"
  ]
}


{
  "name": "@ceiba/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CEIBA API Studio — API de negocio (NestJS 12 + adaptador Fastify, ADR-0001). Sesión con estado, CSRF siempre activo y autorización por recurso (ADR-0009).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "install:isolated": "pnpm install --ignore-workspace --allow-build argon2",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test --test-reporter=spec \"dist-test/test/**/*.test.js\"",
    "test:ci": "node --test --test-reporter=tap \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "argon2": "0.45.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "argon2"
    ]
  }
}

{
  "name": "@ceiba/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CEIBA API Studio — interfaz web (Vue 3 + TypeScript + Vite + Pinia + Vue Router). Tema oscuro por defecto, sesión en cookie HttpOnly (C-31) y CSRF por doble envío.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "install:isolated": "pnpm install --ignore-workspace",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:no-token-storage": "node scripts/check-no-token-storage.ts",
    "check:estandar-visual": "node scripts/check-estandar-visual.ts",
    "check": "node scripts/check-no-token-storage.ts && node scripts/check-estandar-visual.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}

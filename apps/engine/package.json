{
  "name": "@ceiba/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CEIBA API Studio — motor de ejecución HTTP aislado (ADR-0002). Sin credenciales de base de datos, sin clave maestra, sin estado.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "test:ci": "node --test --test-reporter=tap test/*.test.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "undici": "8.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
